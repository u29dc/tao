{
	"name": "tao",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git@github.com:u29dc/tao.git"
	},
	"scripts": {
		"core --------------------------------------------": "",
		"prepare": "husky",
		"dev": "./target/release/tao",
		"build": "bun run release:all",
		"update": "cargo update && bun update --latest",
		"release -----------------------------------------": "",
		"release:all": "./scripts/release.sh --target all",
		"release:cli": "./scripts/release.sh --target cli",
		"util --------------------------------------------": "",
		"util:clean": "./scripts/clean.sh",
		"util:path-guards": "./scripts/tests/path_guards_test.sh",
		"util:biome": "bunx @biomejs/biome check biome.json package.json commitlint.config.js lint-staged.config.js",
		"util:format": "cargo fmt --all -- --check",
		"util:format:write": "cargo fmt --all",
		"util:lint": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
		"util:types": "cargo check --workspace --release",
		"util:test": "cargo test --workspace --release",
		"util:audit": "cargo audit",
		"util:check": "bun run util:path-guards && bun run util:biome && bun run util:format && bun run util:lint && bun run util:types && bun run util:test && bun run util:audit && bun run build",
		"bench -------------------------------------------": "",
		"bench": "./scripts/bench.sh",
		"bench:smoke": "./scripts/bench.sh --suite cli --profile 1k --runs 1 --warmup 0",
		"bench:budget": "./scripts/budgets.sh --profile 5k"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.5"
	}
}
