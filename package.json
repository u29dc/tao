{
	"name": "tao",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git@github.com:u29dc/tao.git"
	},
	"scripts": {
		"core --------------------------------------------": "",
		"prepare": "husky",
		"dev": "./target/release/tao",
		"build": "python3 -B scripts/release.py build",
		"update": "./scripts/cargo.sh update && bun update --latest",
		"release -----------------------------------------": "",
		"release:all": "python3 -B scripts/release.py package --target all",
		"release:cli": "python3 -B scripts/release.py package --target cli",
		"release:install": "python3 -B scripts/release.py install",
		"release:uninstall": "python3 -B scripts/release.py uninstall",
		"util --------------------------------------------": "",
		"util:clean": "python3 -B scripts/release.py clean",
		"util:scripts": "python3 -B scripts/test.py scripts",
		"util:path-guards": "python3 -B scripts/test.py scripts paths",
		"util:biome": "bunx @biomejs/biome check biome.json package.json commitlint.config.js lint-staged.config.js",
		"util:format": "./scripts/cargo.sh fmt --all -- --check",
		"util:format:write": "./scripts/cargo.sh fmt --all",
		"util:lint": "./scripts/cargo.sh clippy --workspace --all-targets --all-features -- -D warnings",
		"util:types": "./scripts/cargo.sh check --workspace --release",
		"util:test": "python3 -B scripts/test.py rust",
		"util:audit": "./scripts/cargo.sh audit",
		"util:check": "bun run util:scripts && bun run util:biome && bun run util:format && bun run util:lint && bun run util:types && bun run util:test && bun run util:audit && bun run build",
		"bench -------------------------------------------": "",
		"bench": "python3 -B scripts/bench.py",
		"bench:smoke": "python3 -B scripts/bench.py --suite cli --profile 1k --runs 1 --warmup 0",
		"bench:budget": "python3 -B scripts/bench.py --suite budget --profile 5k"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1"
	}
}
